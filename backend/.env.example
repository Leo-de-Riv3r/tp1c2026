# Copiar este archivo como .env y completar los valores
# NUNCA subir .env al repositorio

# Para Docker Compose (mongo service via Docker network):
# Para ejecutar local fuera de Docker, sobreescribir:
#   $env:SPRING_MONGODB_URI="mongodb://localhost:27018/tacs_db"
SPRING_MONGODB_URI=mongodb://mongo:27017/tacs_db
MONGO_DATABASE=tacs_db

# Para auth:
JWT_SECRET=
JWT_EXPIRATION=31536000000

# URI del frontend (origen(es) permitidos para CORS, separados por coma):
FRONTEND_URI=http://localhost

# Load test (docker-compose load-test / mongo-seed-load-test services):
LOAD_TEST_USER_COUNT=50
LOAD_TEST_DURATION=60
LOAD_TEST_START_USERS=5
LOAD_TEST_MAX_USERS=50
