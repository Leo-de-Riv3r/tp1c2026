# Copiar este archivo como .env y completar los valores
# NUNCA subir .env al repositorio

# Para Docker Compose (mongo service via Docker network):
# Para ejecutar local fuera de Docker, sobreescribir:
#   $env:SPRING_DATA_MONGODB_URI="mongodb://localhost:27018/tacs_db"
SPRING_DATA_MONGODB_URI=mongodb://mongo:27017/tacs_db
MONGO_DATABASE=tacs_db

# Para auth:
JWT_SECRET=
JWT_EXPIRATION=31536000000

# URI del frontend (origen(es) permitidos para CORS, separados por coma):
FRONTEND_URI=http://localhost