# Copiar este archivo como .env y completar los valores
# NUNCA subir .env al repositorio

# MongoDB — el BE lee SPRING_MONGODB_URI. Para Docker Compose (mongo via Docker network):
# Para ejecutar local fuera de Docker, sobreescribir, ej:
#   $env:SPRING_MONGODB_URI="mongodb://localhost:27018/tacs_db?directConnection=true"
SPRING_MONGODB_URI=mongodb://mongo:27017/tacs_db?directConnection=true

# Sesiones (auth): TTL de la sesión en ms. Opcional — default 1h (3600000).
SESSION_TTL=3600000

# URI del frontend (origen(es) permitidos para CORS, separados por coma):
FRONTEND_URI=http://localhost

# Load test (solo aplican al profile load-test: servicios mongo-seed-load-test / backend-loadtest / load-test):
LOAD_TEST_USER_COUNT=50
LOAD_TEST_DURATION=60
LOAD_TEST_START_USERS=5
LOAD_TEST_MAX_USERS=50
